# Base locale de développement. Ce mot de passe ne sert qu’au cluster PostgreSQL de la machine.
DATABASE_URL="postgresql://ubuntu:gestion_ia_local@127.0.0.1:5432/gestion_ia"

# Ollama sur le PC hôte (carte graphique). L’Ubuntu appelle cette adresse.
# VM VirtualBox en NAT : http://10.0.2.2:11434
OLLAMA_BASE_URL="http://192.168.1.5:11434"
# Modèle de conversation, environ 7 milliards de paramètres. Vide : le premier modèle adapté.
# qwen-dgfip-multisec-2ep ou qwen2.5:7b tiennent avec 16 Go. Éviter un 14B ou Mixtral.
OLLAMA_MODEL=""
# Index des fiches. nomic-embed-text se charge puis se décharge avant la conversation.
OLLAMA_EMBED_MODEL="nomic-embed-text"
