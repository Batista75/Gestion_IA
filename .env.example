# Secret du cookie de session. Au moins 16 caractères. S’il manque, un secret local de développement est utilisé.
SESSION_SECRET=""

# Base locale de développement. Ce mot de passe ne sert qu’au cluster PostgreSQL de la machine.
DATABASE_URL="postgresql://ubuntu:gestion_ia_local@127.0.0.1:5432/gestion_ia"

# Valeurs de départ. L’écran Configuration les remplace dès qu’il est enregistré.
# Ollama sur le PC hôte (carte graphique). L’Ubuntu appelle cette adresse.
# VM VirtualBox en NAT : http://10.0.2.2:11434
OLLAMA_BASE_URL="http://192.168.1.5:11434"
# Vide : le premier modèle adapté du serveur.
# Conversation : Qwen2.5-14B-Instruct en Q4_K_M s’il est installé, souvent qwen2.5:14b.
OLLAMA_MODEL=""
# Embeddings : bge-m3 s’il est installé, sinon nomic-embed-text. Il se décharge avant la conversation.
OLLAMA_EMBED_MODEL=""
# Reranker : bge-reranker-v2-m3 s’il est installé. Vide : le tri reste lexical et vectoriel.
OLLAMA_RERANK_MODEL=""
