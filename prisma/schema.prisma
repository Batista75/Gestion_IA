generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String   @id @default(cuid())
  name          String
  primaryClient String
  status        String   @default("À qualifier")
  nextAction    String
  createdAt     DateTime @default(now())
}

model InboxItem {
  id        String       @id @default(cuid())
  body      String
  createdAt DateTime     @default(now())
  files     StoredFile[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  kind        String   @default("")
  civility    String   @default("")
  tradeName   String   @default("")
  legalForm   String   @default("")
  country     String   @default("")
  postalCode  String   @default("")
  city        String   @default("")
  siren       String   @default("")
  siret       String   @default("")
  vatNumber   String   @default("")
  contactName String   @default("")
  contactRole String   @default("")
  email       String   @default("")
  phone       String   @default("")
  address     String   @default("")
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientProposal {
  id        String   @id @default(cuid())
  status    String   @default("en_attente")
  payload   Json
  createdAt DateTime @default(now())

  @@index([status])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  nameKey   String    @unique
  siren     String    @default("")
  email     String    @default("")
  phone     String    @default("")
  address   String   @default("")
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  nameKey     String      @unique
  reference   String      @default("")
  unit        String      @default("u")
  description String      @default("")
  source      String      @default("manuel")
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       QuoteLine[]

  @@index([source])
}

model StoredFile {
  id            String     @id @default(cuid())
  inboxItemId   String?
  inboxItem     InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String     @default("")
  sizeBytes     Int
  storagePath   String
  extractedText String     @default("")
  kind          String     @default("autre")
  enrichment    String     @default("")
  contentHash   String     @default("")
  createdAt     DateTime   @default(now())
  quotes        Quote[]

  @@index([inboxItemId])
  @@index([contentHash])
}

model Quote {
  id           String      @id @default(cuid())
  title        String
  issuedOn     String      @default("")
  supplierName String      @default("")
  versionLabel String      @default("")
  fingerprint  String?     @unique
  fileId       String?
  file         StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  lines        QuoteLine[]

  @@index([fileId])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  sourceType  String
  sourceId    String
  title       String
  summary     String   @default("")
  body        String
  contentHash String
  embedding   Json
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String
  statedPrice String  @default("")
  conditions  String  @default("")
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}
