generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id            String         @id @default(cuid())
  name          String
  primaryClient String
  status        String         @default("À qualifier")
  nextAction    String
  purpose       String         @default("")
  reference     String         @default("")
  sector        String         @default("")
  currency      String         @default("EUR")
  budgetStated  String         @default("")
  lead          String         @default("")
  createdAt     DateTime       @default(now())
  events        ProjectEvent[]
  quotes        Quote[]
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  fileId    String   @default("")
  createdAt DateTime @default(now())

  @@index([projectId])
}

model InboxItem {
  id        String       @id @default(cuid())
  body      String
  createdAt DateTime     @default(now())
  files     StoredFile[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  kind        String   @default("")
  civility    String   @default("")
  tradeName   String   @default("")
  legalForm   String   @default("")
  country     String   @default("")
  postalCode  String   @default("")
  city        String   @default("")
  siren       String   @default("")
  siret       String   @default("")
  vatNumber   String   @default("")
  contactName String   @default("")
  contactRole String   @default("")
  email       String   @default("")
  phone       String   @default("")
  address     String   @default("")
  notes       String   @default("")
  reference   String   @default("")
  sector      String   @default("")
  currency    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ClientProposal {
  id        String   @id @default(cuid())
  status    String   @default("en_attente")
  payload   Json
  createdAt DateTime @default(now())

  @@index([status])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  nameKey   String    @unique
  siren     String    @default("")
  email     String    @default("")
  phone     String    @default("")
  address   String   @default("")
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  nameKey     String      @unique
  reference   String      @default("")
  unit        String      @default("u")
  description String      @default("")
  source      String      @default("manuel")
  kind        String      @default("produit")
  statedPrice String      @default("")
  currency    String      @default("")
  vatNote     String      @default("")
  costStated  String      @default("")
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       QuoteLine[]

  @@index([source])
}

model StoredFile {
  id            String     @id @default(cuid())
  inboxItemId   String?
  inboxItem     InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String     @default("")
  sizeBytes     Int
  storagePath   String
  extractedText String     @default("")
  kind          String     @default("autre")
  enrichment    String     @default("")
  contentHash   String     @default("")
  createdAt     DateTime   @default(now())
  quotes        Quote[]
  proposals     DocumentProposal[]
  demands       Demand[]

  @@index([inboxItemId])
  @@index([contentHash])
}

model Demand {
  id           String      @id @default(cuid())
  title        String
  reference    String      @default("")
  clientName   String      @default("")
  supplierName String      @default("")
  status       String      @default("ouverte")
  fileId       String?
  file         StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([fileId])
  @@index([status])
}

model DocumentProposal {
  id        String      @id @default(cuid())
  status    String      @default("en_attente")
  fileId    String?
  file      StoredFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  summary   String
  payload   Json
  createdAt DateTime    @default(now())

  @@index([status])
  @@index([fileId])
}

model Quote {
  id           String      @id @default(cuid())
  title        String
  issuedOn     String      @default("")
  supplierName String      @default("")
  versionLabel String      @default("")
  fingerprint  String?     @unique
  fileId         String?
  file           StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientName     String      @default("")
  currency       String      @default("")
  vatZone        String      @default("")
  vatMention     String      @default("")
  statedTotalHt  String      @default("")
  statedVat      String      @default("")
  statedTotalTtc String      @default("")
  conditions     String      @default("")
  createdAt      DateTime    @default(now())
  lines          QuoteLine[]

  @@index([fileId])
  @@index([projectId])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  sourceType  String
  sourceId    String
  title       String
  summary     String   @default("")
  body        String
  contentHash String
  embedding   Json
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String
  statedPrice String  @default("")
  conditions  String  @default("")
  quantity    String  @default("")
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}
