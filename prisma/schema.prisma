generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AppSetting {
  id         String   @id @default("local")
  serverUrl  String   @default("")
  apiKey     String   @default("")
  chatModel   String   @default("")
  embedModel  String   @default("")
  rerankModel String   @default("")
  updatedAt   DateTime @updatedAt
}

model CompanyProfile {
  id         String   @id @default("local")
  legalName  String   @default("")
  address    String   @default("")
  postalCode String   @default("")
  city       String   @default("")
  country    String   @default("")
  email      String   @default("")
  phone      String   @default("")
  siren      String   @default("")
  vatNumber  String   @default("")
  logoPath   String   @default("")
  logoMime   String   @default("")
  updatedAt  DateTime @updatedAt
}

model Project {
  id            String         @id @default(cuid())
  name          String
  primaryClient String
  status        String         @default("À qualifier")
  nextAction    String
  purpose       String         @default("")
  reference     String         @default("")
  sector        String         @default("")
  currency      String         @default("EUR")
  budgetStated  String         @default("")
  lead          String         @default("")
  clientId      String?
  client        Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  tradeKey             String         @default("achat-revente-technologies")
  deliveryRecipient    String         @default("")
  deliveryAddress      String         @default("")
  deliveryPostalCode   String         @default("")
  deliveryCity         String         @default("")
  deliveryCountry      String         @default("")
  deliveryContact      String         @default("")
  deliveryPhone        String         @default("")
  deliverySlot         String         @default("")
  deliveryMode         String         @default("")
  deliveryNote         String         @default("")
  createdAt            DateTime       @default(now())
  events        ProjectEvent[]
  quotes        Quote[]
  conversations Conversation[]
  lines         ProjectLine[]
  sales         SaleDocument[]
  steps         ProjectStep[]

  @@index([clientId])
}

model ProjectStep {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepKey    String
  status     String    @default("a_faire")
  proofRef   String    @default("")
  proofNote  String    @default("")
  recordedAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@unique([projectId, stepKey])
  @@index([projectId])
}

model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind      String
  body      String
  fileId    String   @default("")
  createdAt DateTime @default(now())

  @@index([projectId])
}

model InboxItem {
  id        String       @id @default(cuid())
  body      String
  createdAt DateTime     @default(now())
  files     StoredFile[]
}

model Client {
  id          String   @id @default(cuid())
  name        String
  nameKey     String   @unique
  kind        String   @default("")
  civility    String   @default("")
  tradeName   String   @default("")
  legalForm   String   @default("")
  country     String   @default("")
  postalCode  String   @default("")
  city        String   @default("")
  siren       String   @default("")
  siret       String   @default("")
  vatNumber   String   @default("")
  contactName String   @default("")
  contactRole String   @default("")
  email       String   @default("")
  phone       String   @default("")
  address     String   @default("")
  notes       String    @default("")
  reference   String    @default("")
  sector      String    @default("")
  currency    String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Conversation {
  id        String                @id @default(cuid())
  title     String                @default("")
  projectId String?
  project   Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  messages  ConversationMessage[]

  @@index([projectId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  source         String       @default("")
  steps          Json?
  proposal       Json?
  sources        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model CatalogProposal {
  id        String   @id @default(cuid())
  status    String   @default("en_attente")
  payload   Json
  createdAt DateTime @default(now())

  @@index([status])
}

model ClientProposal {
  id        String   @id @default(cuid())
  status    String   @default("en_attente")
  payload   Json
  createdAt DateTime @default(now())

  @@index([status])
}

model RecordEvent {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  entityName String
  action     String
  summary    String
  source     String   @default("")
  actor      String   @default("J Smith")
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model Supplier {
  id        String    @id @default(cuid())
  name      String
  nameKey   String    @unique
  siren     String    @default("")
  email     String    @default("")
  phone     String    @default("")
  address   String   @default("")
  notes     String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  nameKey     String      @unique
  reference   String      @default("")
  unit        String      @default("u")
  description String      @default("")
  source      String      @default("manuel")
  kind        String      @default("produit")
  statedPrice String      @default("")
  currency    String      @default("")
  vatNote     String      @default("")
  costStated  String      @default("")
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lines        QuoteLine[]
  projectLines ProjectLine[]

  @@index([source])
}

model StoredFile {
  id            String     @id @default(cuid())
  inboxItemId   String?
  inboxItem     InboxItem? @relation(fields: [inboxItemId], references: [id], onDelete: Cascade)
  originalName  String
  mimeType      String     @default("")
  sizeBytes     Int
  storagePath   String
  extractedText String     @default("")
  kind          String     @default("autre")
  enrichment    String     @default("")
  contentHash   String     @default("")
  createdAt     DateTime   @default(now())
  quotes        Quote[]
  proposals     DocumentProposal[]
  demands       Demand[]

  @@index([inboxItemId])
  @@index([contentHash])
}

model Demand {
  id           String      @id @default(cuid())
  title        String
  reference    String      @default("")
  clientName   String      @default("")
  supplierName String      @default("")
  status       String      @default("ouverte")
  fileId       String?
  file         StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([fileId])
  @@index([status])
}

model DocumentProposal {
  id        String      @id @default(cuid())
  status    String      @default("en_attente")
  fileId    String?
  file      StoredFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  summary   String
  payload   Json
  createdAt DateTime    @default(now())

  @@index([status])
  @@index([fileId])
}

model Quote {
  id           String      @id @default(cuid())
  title        String
  issuedOn     String      @default("")
  supplierName String      @default("")
  versionLabel String      @default("")
  fingerprint  String?     @unique
  fileId         String?
  file           StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientName     String      @default("")
  currency       String      @default("")
  vatZone        String      @default("")
  vatMention     String      @default("")
  statedTotalHt  String      @default("")
  statedVat      String      @default("")
  statedTotalTtc String      @default("")
  conditions     String      @default("")
  createdAt      DateTime    @default(now())
  lines          QuoteLine[]

  @@index([fileId])
  @@index([projectId])
}

model KnowledgeChunk {
  id          String   @id @default(cuid())
  sourceType  String
  sourceId    String
  title       String
  summary     String   @default("")
  body        String
  contentHash String
  embedding   Json
  updatedAt   DateTime @updatedAt

  @@unique([sourceType, sourceId])
  @@index([sourceType])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  productId   String
  statedPrice String  @default("")
  conditions  String  @default("")
  quantity    String  @default("")
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([productId])
}

model ProjectLine {
  id              String    @id @default(cuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind            String    @default("produit")
  name            String
  supplierName    String    @default("")
  quantity        Int       @default(1)
  costCents       Int?
  markupPercent   Int       @default(30)
  discountPercent Int       @default(0)
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([projectId])
}

model SaleDocument {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  kind         String
  status       String             @default("en_cours")
  title        String
  supplierName String             @default("")
  sourceId     String             @default("")
  confirmedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        SaleDocumentLine[]

  @@index([projectId])
}

model SaleDocumentLine {
  id              String       @id @default(cuid())
  documentId      String
  document        SaleDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kind            String       @default("produit")
  name            String
  supplierName    String       @default("")
  quantity        Int          @default(1)
  costCents       Int?
  markupPercent   Int          @default(30)
  discountPercent Int          @default(0)
  createdAt       DateTime     @default(now())

  @@index([documentId])
}
